# The compose file of the Agentic Slack Bot, as deployed. Generated by Ansible: do not edit it on the host.
# Taken from docker-compose.yml of agentic-slack-bot, with two changes for a host that runs the pre-built image:
#   - receiver, worker and scheduler use the image of slack_bot_deploy_image_tag, not a local build
#   - the worker does not mount ./src/worker/skills: the skills are part of the image
#   - published ports are bound to 127.0.0.1, since the services reach each other over the compose network and the
#     ngrok tunnel reaches the receiver as receiver:8123 (a host that needs them from outside must say so here)
#   - ngrok is pinned to a version, not latest
# When the application changes its compose file, change this file in the same pull request as the image tag.
services:
  redis:
    image: redis:7-alpine
    restart: unless-stopped
    ports:
      - "127.0.0.1:6379:6379"
    volumes:
      - redis_data:/data
    command: redis-server --appendonly yes
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

  receiver:
    image: {{ slack_bot_deploy_image_repo }}:{{ slack_bot_deploy_image_tag }}
    environment:
      SERVICE: receiver
      SUPABASE_DB_URL: ${SUPABASE_DB_URL}
      REDIS_URL: redis://redis:6379/0
    depends_on:
      redis:
        condition: service_healthy
    ports:
      - "127.0.0.1:8123:8123"
    restart: unless-stopped
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8123/healthz')"]
      interval: 10s
      timeout: 5s
      retries: 3
      start_period: 5s

  worker:
    image: {{ slack_bot_deploy_image_repo }}:{{ slack_bot_deploy_image_tag }}
    environment:
      SERVICE: worker
      SUPABASE_DB_URL: ${SUPABASE_DB_URL}
      REDIS_URL: redis://redis:6379/0
      OPENAI_API_KEY: ${OPENAI_API_KEY}
      DATABRICKS_HOST: ${DATABRICKS_HOST}
      DATABRICKS_WAREHOUSE_ID: ${DATABRICKS_WAREHOUSE_ID}
      DATABRICKS_ACCESS_TOKEN: ${DATABRICKS_ACCESS_TOKEN}
      GIT_REPO_PAT_DATA_PLATFORM: ${GIT_REPO_PAT_DATA_PLATFORM}
      GITHUB_APP_ID: ${GITHUB_APP_ID}
      GITHUB_APP_PRIVATE_KEY: ${GITHUB_APP_PRIVATE_KEY}
      GITHUB_APP_INSTALLATION_ID: ${GITHUB_APP_INSTALLATION_ID}
      SECRET_ENCRYPTION_KEY: ${SECRET_ENCRYPTION_KEY}
      SECRET_LINK_BASE_URL: ${SECRET_LINK_BASE_URL}
    depends_on:
      redis:
        condition: service_healthy
    restart: unless-stopped
    deploy:
      replicas: ${WORKER_COUNT:-2}

  scheduler:
    image: {{ slack_bot_deploy_image_repo }}:{{ slack_bot_deploy_image_tag }}
    environment:
      SERVICE: scheduler
      SUPABASE_DB_URL: ${SUPABASE_DB_URL}
      REDIS_URL: redis://redis:6379/0
      SCHEDULER_INTERVAL: "180"
    depends_on:
      redis:
        condition: service_healthy
    restart: unless-stopped

  ngrok:
    image: ngrok/ngrok:3.39.13-debian
    restart: unless-stopped
    command: http receiver:8123
    environment:
      NGROK_AUTHTOKEN: ${NGROK_AUTHTOKEN}
    ports:
      - "127.0.0.1:4040:4040"
    depends_on:
      receiver:
        condition: service_healthy

volumes:
  redis_data:
